<routes>

    <!-- RSU -->
    <vType id="rsu" type="rsu" depart="0">
        <param key="has.btsender.device" value="true"/>
        <param key="has.btreceiver.device" value="true"/>
    </vType>

    <!-- Driving Car vType -->
    <vType id="car" accel="0.8" decel="4.5" sigma="0.5" length="5" maxSpeed="45">
        <param key="has.btsender.device" value="true"/>
        <param key="has.btreceiver.device" value="true"/>
    </vType>


    <!-- Driving Car Route Definitions -->
    <route id="route1" edges="E0 E1 E2"/>
    <route id="route_rsu" edges="E3"/>

    <!-- RSU Defined -->
    <vehicle id="rsu1" type="rsu" route="route_rsu" depart="0">
        <stop parkingArea="pa_0" duration="100" parking="true"/>
    </vehicle>

    <!-- Driving Car Defined -->
    <vehicle id="car1" type="car" route="route1" depart="10"/>
    
</routes>